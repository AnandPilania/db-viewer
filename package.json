{
  "name": "@pilaniaanand/db-viewer",
  "version": "0.5.4",
  "description": "Browse and query Postgres, MySQL, SQLite, MongoDB, Redis, and ClickHouse from one local web UI.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "db-viewer": "./bin/db-viewer.js"
  },
  "files": [
    "bin",
    "server",
    "public",
    "scripts/prepack.mjs"
  ],
  "scripts": {
    "start": "node bin/db-viewer.js",
    "predev": "pnpm --filter \"@pilaniaanand/driver-*\" run build",
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "dev:server": "pnpm --filter \"@pilaniaanand/driver-*\" run build && pnpm --filter server run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm --filter \"@pilaniaanand/driver-*\" run build && pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "pnpm run build",
    "prepack": "node scripts/prepack.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@pilaniaanand/driver-interface": "workspace:*",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "database",
    "gui",
    "postgres",
    "mysql",
    "sqlite",
    "mongodb",
    "redis",
    "clickhouse"
  ],
  "license": "MIT"
}
