    "jose": "^5.9.6",
    "nanoid": "^6.0.1",
    "lucide-react": "^1.41.0",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "^4.0.2",
    "recharts": "^3.10.1"
  },
  "peerDependencies": {
    "fastify": "^5",
    "react": "^19"
  },
  "devDependencies": {
    "@fastify/websocket": "^11.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "fastify": "^5.12.3",
    "react": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ],
