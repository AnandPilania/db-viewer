{
  "name": "@pilaniaanand/module-dashboards",
  "version": "0.6.0",
  "type": "module",
  "exports": {
    "./web": "./dist/web/index.js",
    "./web/embed": "./dist/web/EmbedDashboard.js",
    "./server": "./dist/server/index.js"
  },
  "scripts": {
